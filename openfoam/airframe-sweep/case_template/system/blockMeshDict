FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object blockMeshDict;
}

convertToMeters 1;

// B 系: x 前弹轴 (来流从 +x 吹向 -x), y 右, z 下, 右手系
// 域尺寸由 make_case.sh 按几何包围盒缩放 (上游 3L / 下游 6L / 侧向 3L)
vertices
(
    (__XL__ __Y0__ __Z0__)
    (__XU__ __Y0__ __Z0__)
    (__XU__ __Y1__ __Z0__)
    (__XL__ __Y1__ __Z0__)
    (__XL__ __Y0__ __Z1__)
    (__XU__ __Y0__ __Z1__)
    (__XU__ __Y1__ __Z1__)
    (__XL__ __Y1__ __Z1__)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (__NX__ __NY__ __NZ__) simpleGrading (1 1 1)
);

edges ();

boundary
(
    inlet
    {
        type patch;
        faces ((1 2 6 5));
    }
    outlet
    {
        type patch;
        faces ((0 4 7 3));
    }
    side
    {
        type patch;
        faces ((0 1 5 4) (3 7 6 2) (0 3 2 1) (4 5 6 7));
    }
);

mergePatchPairs ();
