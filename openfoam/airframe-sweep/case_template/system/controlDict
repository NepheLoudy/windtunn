FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application     foamRun;
solver          incompressibleFluid;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         800;          // 校验点; 定量表工况 1500-2000

deltaT          1;

writeControl    timeStep;
writeInterval   400;
purgeWrite      2;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
runTimeModifiable true;

functions
{
    forces
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   10;
        patches         (__SURFACES_LIST__);
        rho             rhoInf;
        rhoInf          1.225;
        CofR            (__COFRX__ 0 0);   // B 系原点(=几何导出原点); 力矩后处理经 mass_properties.com_B 平移 (recompute_cm.py 可重算)
        pitchAxis       (0 1 0);
    }
}
