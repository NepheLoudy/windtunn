FoamFile
{
    format      ascii;
    class       dictionary;
    object      meshQualityDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2026-11-18 随 snappyHexMeshDict 整体换代引入: 拷自官方
//   /home/qianli/OpenFOAM-12-20250206/etc/caseDicts/mesh/generation/meshQualityDict
// 唯一改动: minVol 保留旧模板调校值 1e-13 (官方 -1e30 禁用; T0 路径实跑未误杀)。
// 旧模板内联键 minArea/minTriangleTwist 为老版本键, OF12 官方键集无, 不迁。

//- Maximum non-orthogonality allowed. Set to 180 to disable.
maxNonOrtho 65;

//- Max skewness allowed. Set to <0 to disable.
maxBoundarySkewness 20;
maxInternalSkewness 4;

//- Max concaveness allowed. Is angle (in degrees) below which concavity
//  is allowed. 0 is straight face, <0 would be convex face.
maxConcave 80;

//- Minimum cell pyramid volume relative to min bounding box length^3
minVol 1e-13;

//- Minimum quality of the tet formed by the face-centre
//  and variable base point minimum decomposition triangles and
//  the cell centre.
minTetQuality 1e-15;

//- Minimum face twist.
minTwist 0.02;

//- Minimum normalised cell determinant.
minDeterminant 0.001;

//- Relative position of face in relation to cell centres.
minFaceWeight 0.05;

//- Volume ratio of neighbouring cells.
minVolRatio 0.01;

nSmoothScale   4;

errorReduction 0.75;

// ************************************************************************* //
