FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet         { type zeroGradient; }
    outlet        { type inletOutlet; inletValue uniform 0; value uniform 0; }
    side          { type inletOutlet; inletValue uniform 0; value uniform 0; }
    body         { type zeroGradient; }
    fin_h_pos    { type zeroGradient; }
    fin_h_neg    { type zeroGradient; }
    fin_v_pos    { type zeroGradient; }
    fin_v_neg    { type zeroGradient; }
}
