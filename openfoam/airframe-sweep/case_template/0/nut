FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet         { type calculated; value uniform 0; }
    outlet        { type calculated; value uniform 0; }
    side          { type calculated; value uniform 0; }
    body         { type nutkWallFunction; value uniform 0; }
    fin_h_pos    { type nutkWallFunction; value uniform 0; }
    fin_h_neg    { type nutkWallFunction; value uniform 0; }
    fin_v_pos    { type nutkWallFunction; value uniform 0; }
    fin_v_neg    { type nutkWallFunction; value uniform 0; }
}
