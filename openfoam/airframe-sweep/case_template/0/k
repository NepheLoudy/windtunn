FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform __KVAL__;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform __KIN__;
    }
    outlet        { type inletOutlet; inletValue uniform __KVAL__; value uniform __KVAL__; }
    side          { type inletOutlet; inletValue uniform __KVAL__; value uniform __KVAL__; }
    body         { type kqRWallFunction; value uniform __KVAL__; }
    fin_h_pos    { type kqRWallFunction; value uniform __KVAL__; }
    fin_h_neg    { type kqRWallFunction; value uniform __KVAL__; }
    fin_v_pos    { type kqRWallFunction; value uniform __KVAL__; }
    fin_v_neg    { type kqRWallFunction; value uniform __KVAL__; }
}
